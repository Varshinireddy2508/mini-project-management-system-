# Root Environment Variables Configuration Template

# Backend (Render)
PORT=8080
DB_URL=jdbc:mysql://<host>:<port>/project_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>
ALLOWED_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173

# Frontend (Vercel)
VITE_API_BASE_URL=https://<your-backend>.onrender.com/api
