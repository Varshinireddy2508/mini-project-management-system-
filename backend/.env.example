# Backend Environment Variables Template (DO NOT COMMIT REAL SECRETS)
# Render Web Service / Production Environment Variables:

PORT=8080
DB_URL=jdbc:mysql://<hosted-mysql-host>:<port>/<database-name>?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USERNAME=<hosted-db-user>
DB_PASSWORD=<hosted-db-password>
ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:5173
